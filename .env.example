# ==============================================================================
# Drishti AI - Production Environment Variables Template
# Copy this file to .env for local development or configure in Railway dashboard
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Security: Allowed CORS origins (comma-separated list of frontend domains)
# Example: https://drishti-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=https://your-frontend.vercel.app

# Storage Configuration
# When deploying to Railway with a Persistent Volume, set this to the mount path (e.g. /app/data)
DATA_DIR=/app/data

# Inference Engine Configuration
# Options: 'sih' (verified RT-DETRv2-R18 ONNX on CPU) | 'mock'
MODEL_MODE=sih
CONFIDENCE_THRESHOLD=0.35
FRAME_SAMPLE_INTERVAL=3

# Resource Management: Limit simultaneous heavy video inference tasks
MAX_CONCURRENT_JOBS=1
